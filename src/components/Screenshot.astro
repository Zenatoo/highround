---
import type { ImageMetadata } from 'astro';
import { getImage, Image } from 'astro:assets';
import { currentLang } from '../i18n/config';
import { colon, t } from '../i18n/ui';

interface Props {
  /** An imported image, or a path inside `content/media/` (e.g. "iw/zombies-in-spaceland/power/power_spawn.webp"). */
  src: ImageMetadata | string;
  alt: string;
  /** Author, or at least the site the image was found on. */
  credit: string;
  /** Link to the exact source page. */
  source: string;
}

const media = import.meta.glob<{ default: ImageMetadata }>('/content/media/**/*.{webp,png,jpg,jpeg}');

const { src: given, alt, credit, source } = Astro.props;

// Fails the build: an image without a visible source is never published.
if (!credit?.trim() || !source?.trim()) {
  throw new Error(`Screenshot "${typeof given === 'string' ? given : given?.src ?? alt}" needs both "credit" and "source".`);
}

let src: ImageMetadata;
if (typeof given === 'string') {
  const load = media[`/content/media/${given}`];
  // Fails the build on a typo instead of publishing a broken image.
  if (!load) throw new Error(`Screenshot: no image at content/media/${given}`);
  src = (await load()).default;
} else {
  src = given;
}

const lang = currentLang(Astro);
// Full size is only downloaded when the user opens the image.
const full = await getImage({ src, width: Math.min(src.width, 1920), format: 'webp' });
---

<figure class="shot">
  <a href={full.src} data-lightbox aria-label={`${t(lang, 'media.open')}${colon(lang)}${alt}`}>
    <Image
      src={src}
      alt={alt}
      width={720}
      widths={[240, 360, 480, 720]}
      sizes="(min-width: 60rem) 22rem, 45vw"
      loading="lazy"
      decoding="async"
    />
  </a>
  <figcaption>
    {t(lang, 'media.source')}{colon(lang)}<a href={source} rel="noopener noreferrer" target="_blank">{credit}</a>
  </figcaption>
</figure>

<style>
  .shot {
    margin: 0.75rem 0;
    max-width: 100%;
  }
  .shot > a {
    display: inline-block;
    border-radius: var(--r-md);
    outline-offset: 3px;
  }
  .shot img {
    display: block;
    width: auto;
    max-height: clamp(10rem, 28vh, 20rem);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    object-fit: contain;
    cursor: zoom-in;
  }
  .shot > a:hover img {
    border-color: var(--accent);
  }
  figcaption {
    margin-top: 0.3rem;
    font-size: 0.8rem;
    color: var(--muted);
  }
  figcaption a {
    color: inherit;
  }
  figcaption a:hover {
    color: var(--accent-text);
  }
</style>
