---
import type { ImageMetadata } from 'astro';
import { getImage, Image } from 'astro:assets';
import type { Locale } from '../i18n/config';
import { t } from '../i18n/ui';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Author, or at least the site the image was found on. */
  credit: string;
  /** Link to the exact source page. */
  source: string;
}

const { src, alt, credit, source } = Astro.props;

// Fails the build: an image without a visible source is never published.
if (!credit?.trim() || !source?.trim()) {
  throw new Error(`Screenshot "${src?.src ?? alt}" needs both "credit" and "source".`);
}

const lang = (Astro.currentLocale ?? 'fr') as Locale;
// Full size is only downloaded when the user opens the image.
const full = await getImage({ src, width: Math.min(src.width, 1920), format: 'webp' });
---

<figure class="shot">
  <a href={full.src} data-lightbox aria-label={`${t(lang, 'media.open')} : ${alt}`}>
    <Image
      src={src}
      alt={alt}
      width={720}
      widths={[240, 360, 480, 720]}
      sizes="(min-width: 60rem) 22rem, 45vw"
      loading="lazy"
      decoding="async"
    />
  </a>
  <figcaption>
    {t(lang, 'media.source')}{lang === 'fr' ? ' : ' : ': '}<a href={source} rel="noopener noreferrer" target="_blank">{credit}</a>
  </figcaption>
</figure>

<style>
  .shot {
    margin: 0.75rem 0;
    max-width: 100%;
  }
  .shot > a {
    display: inline-block;
    border-radius: var(--r-md);
    outline-offset: 3px;
  }
  .shot img {
    display: block;
    width: auto;
    max-height: clamp(10rem, 28vh, 20rem);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    object-fit: contain;
    cursor: zoom-in;
  }
  .shot > a:hover img {
    border-color: var(--accent);
  }
  figcaption {
    margin-top: 0.3rem;
    font-size: 0.8rem;
    color: var(--muted);
  }
  figcaption a {
    color: inherit;
  }
  figcaption a:hover {
    color: var(--accent-text);
  }
</style>
