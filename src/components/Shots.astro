---
// Groups the screenshots of one step on a single row instead of stacking them.
---

<div class="shots"><slot /></div>

<style>
  .shots {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-block: 0.75rem;
  }
  .shots > :global(.shot) {
    flex: 1 1 8rem;
    max-width: 15rem;
    min-width: 0;
    margin: 0;
  }
  .shots > :global(.shot > a) {
    display: block;
  }
  .shots > :global(.shot) :global(img) {
    width: 100%;
    max-height: clamp(7rem, 22vh, 11rem);
    object-fit: cover;
  }
</style>
