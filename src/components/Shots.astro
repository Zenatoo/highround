---
// Groups the screenshots of one step on a single row instead of stacking them.
---

<div class="shots"><slot /></div>

<style>
  /* Equal columns: a lone last image keeps the same size as the others. */
  .shots {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 9.5rem), 1fr));
    gap: 0.75rem;
    margin-block: 0.75rem;
  }
  .shots > :global(.shot) {
    min-width: 0;
    margin: 0;
  }
  .shots > :global(.shot > a) {
    display: block;
  }
  .shots > :global(.shot) :global(img) {
    width: 100%;
    max-height: none;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }
</style>
