---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../i18n/config';
import { t } from '../i18n/ui';

interface Props {
  map: CollectionEntry<'maps'>;
  size: 'hero' | 'tile';
  lang: Locale;
}

const { map, size, lang } = Astro.props;
const { banner, color, name } = map.data;
// Big outlined word in the generated art: the most recognisable word of the map name.
const word = name.split(' ').sort((a, b) => b.length - a.length)[0];
const widths = size === 'tile' ? [320, 480, 640] : [640, 960, 1280, 1600];
---

<div class:list={['art', `art-${size}`, `c-${color}`, { 'has-image': banner }]}>
  {
    banner ? (
      <Image
        src={banner.image}
        alt=""
        widths={widths}
        sizes={size === 'tile' ? '(min-width: 60rem) 20rem, 90vw' : '(min-width: 60rem) 70vw, 100vw'}
        loading={size === 'hero' ? 'eager' : 'lazy'}
        decoding="async"
        class="art-img"
      />
    ) : (
      <span class="art-word" aria-hidden="true" data-pagefind-ignore>{word}</span>
    )
  }
  <div class="art-content"><slot /></div>
  {
    banner && (
      <a class="art-credit" href={banner.source} target="_blank" rel="noopener noreferrer">
        {t(lang, 'media.source')} : {banner.credit}
      </a>
    )
  }
</div>

<style>
  .art {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    background:
      radial-gradient(120% 140% at 100% 0%, color-mix(in oklab, var(--c1) 55%, transparent), transparent 55%),
      radial-gradient(90% 120% at 0% 100%, color-mix(in oklab, var(--c2) 60%, transparent), transparent 60%),
      repeating-linear-gradient(135deg, rgb(255 255 255 / 0.035) 0 1px, transparent 1px 14px),
      var(--raised);
  }
  .art-hero {
    min-height: clamp(14rem, 30vw, 22rem);
  }
  .art-tile {
    aspect-ratio: 16 / 9;
    border-radius: var(--r-md);
  }
  /* Dark fade so the title stays readable on any art. */
  .art::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to top, color-mix(in oklab, var(--bg) 94%, transparent), color-mix(in oklab, var(--bg) 25%, transparent) 55%, transparent);
  }
  .art-img {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .art-word {
    position: absolute;
    right: -0.05em;
    top: 50%;
    z-index: -1;
    transform: translateY(-62%);
    font-family: var(--font-head);
    font-size: clamp(5rem, 14vw, 11rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1.5px color-mix(in oklab, var(--c1) 55%, transparent);
    white-space: nowrap;
    user-select: none;
  }
  .art-tile .art-word {
    font-size: 4.5rem;
    -webkit-text-stroke-width: 1px;
  }
  .art-content {
    position: relative;
    width: 100%;
    padding: clamp(1rem, 0.6rem + 1.5vw, 1.75rem);
  }
  .art-tile .art-content {
    padding: 0.9rem 1rem;
  }
  .art-credit {
    position: absolute;
    top: 0.6rem;
    right: 0.75rem;
    padding: 0.1rem 0.5rem;
    border-radius: var(--r-sm);
    background: color-mix(in oklab, var(--bg) 70%, transparent);
    color: var(--muted);
    font-size: var(--fs-xs);
  }
</style>
