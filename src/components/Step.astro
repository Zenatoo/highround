---
interface Props {
  title: string;
}

const { title } = Astro.props;
const id = `step-${title
  .toLowerCase()
  .normalize('NFD')
  .replace(/[̀-ͯ]/g, '')
  .replace(/[^a-z0-9]+/g, '-')
  .replace(/^-|-$/g, '')}`;
---

<li class="step" id={id}>
  <input type="checkbox" id={`${id}-done`} class="step-box" data-step />
  <label for={`${id}-done`} class="step-head">
    <span class="step-num" aria-hidden="true"></span>
    <span class="step-title-text">{title}</span>
  </label>
  <div class="step-body"><slot /></div>
</li>

<style>
  .step {
    position: relative;
    counter-increment: step;
    padding: 1rem 1.1rem 1.1rem;
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    background: var(--surface);
    scroll-margin-top: calc(var(--topbar) + 4rem);
  }
  .step-box {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .step-head {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    cursor: pointer;
  }
  .step-num {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.1rem;
    height: 2.1rem;
    border: 2px solid var(--border);
    border-radius: 50%;
    font-family: var(--font-head);
    font-size: var(--fs-sm);
    font-weight: 800;
    transition: background-color 0.15s, border-color 0.15s;
  }
  .step-num::before {
    content: counter(step);
  }
  .step-head:hover .step-num {
    border-color: var(--accent);
  }
  .step-title-text {
    font-family: var(--font-head);
    font-size: var(--fs-lg);
    font-weight: 700;
    line-height: 1.3;
  }
  .step-body {
    margin: 0.6rem 0 0 2.9rem;
    max-width: var(--measure);
    color: color-mix(in oklab, var(--text) 88%, var(--muted));
  }
  .step-body > :global(:first-child) {
    margin-top: 0;
  }
  .step-body > :global(:last-child) {
    margin-bottom: 0;
  }
  .step-box:focus-visible + .step-head .step-num {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .step-box:checked + .step-head .step-num {
    border-color: var(--ok);
    background: var(--ok);
    color: var(--bg);
  }
  .step-box:checked + .step-head .step-num::before {
    content: '✓';
  }
  .step-box:checked + .step-head .step-title-text {
    color: var(--muted);
    text-decoration: line-through;
  }
  .step:has(.step-box:checked) {
    border-color: color-mix(in oklab, var(--ok) 30%, transparent);
    background: color-mix(in oklab, var(--surface) 92%, var(--ok));
  }
  .step:has(.step-box:checked) .step-body {
    opacity: 0.6;
  }
  @media (max-width: 40rem) {
    .step-body {
      margin-left: 0;
    }
  }
</style>
