---
import { currentLang } from '../i18n/config';
import { t } from '../i18n/ui';
import Icon from './Icon.astro';

const lang = currentLang(Astro);
---

<!-- Collapsed by default: the main steps must work without tips. -->
<details class="tips">
  <summary>
    <Icon name="lightbulb" />
    {t(lang, 'tips.summary')}
    <Icon name="chevron-right" class="tips-chevron" />
  </summary>
  <div class="tips-list"><slot /></div>
</details>

<style>
  .tips {
    margin-top: 0.85rem;
  }
  summary {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.25rem;
    padding: 0 0.75rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--accent-text);
    font-size: var(--fs-sm);
    font-weight: 700;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover {
    background: var(--raised);
  }
  summary :global(.tips-chevron) {
    transition: transform 0.15s;
  }
  .tips[open] summary :global(.tips-chevron) {
    transform: rotate(90deg);
  }
  .tips-list {
    display: grid;
    gap: 0.5rem;
    margin-top: 0.6rem;
  }
</style>
