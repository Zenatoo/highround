---
import { currentLang } from '../i18n/config';
import { chainOf, FINALS, PRODUCTS, REACTIONS, WHERE, type ProductKey } from '../lib/chemistry';

const lang = currentLang(Astro);
const L = {
  fr: {
    pick: 'Choisis un produit final : seule sa recette s’affiche.',
    reaction: 'Réaction',
    makes: 'donne',
    put: 'À poser sur la table :',
    made: 'Fabriqué par une réaction plus haut : il sort à droite du garage',
    board: 'Losange sur le tableau : ',
    bomb: 'Porte le produit final à la bombe.',
  },
  en: {
    pick: 'Pick a final chemical: only its recipe shows.',
    reaction: 'Reaction',
    makes: 'makes',
    put: 'Put on the table:',
    made: 'Made by a reaction above: it comes out on the right of the garage',
    board: 'Diamond on the board: ',
    bomb: 'Take the final chemical to the bomb.',
  },
}[lang];

const name = (key: ProductKey) => PRODUCTS[key].name[lang];
// Every recipe is rendered: without JavaScript they all show, one after the other.
const recipes = FINALS.map((final) => ({
  final,
  steps: chainOf(final).map((made) => ({
    made,
    inputs: (REACTIONS[made] ?? []).map((key) => ({
      key,
      where: WHERE[key]?.[lang] ?? L.made,
      board: PRODUCTS[key].board[lang],
    })),
  })),
}));
---

<section class="recipes" data-recipes>
  <fieldset class="pick" data-pick hidden>
    <legend>{L.pick}</legend>
    <div class="chips">
      {
        FINALS.map((key) => (
          <label class="chip">
            <input type="radio" name="chem-recipe" value={key} />
            <span>{name(key)}</span>
          </label>
        ))
      }
    </div>
  </fieldset>

  {
    recipes.map((recipe) => (
      <article class="recipe" data-recipe={recipe.final} aria-label={name(recipe.final)}>
        <h3 class="recipe-title">{name(recipe.final)}</h3>
        <ol class="reactions">
          {recipe.steps.map((step, i) => (
            <li class="reaction">
              <p class="reaction-head">
                <span class="reaction-num">
                  {L.reaction} {i + 1}
                </span>
                <span>
                  {L.makes} <strong>{name(step.made)}</strong>
                </span>
              </p>
              <p class="put">{L.put}</p>
              <ul class="inputs">
                {step.inputs.map((input) => (
                  <li>
                    <strong>{name(input.key)}</strong>
                    <span class="where">{input.where}</span>
                    <span class="board">
                      {L.board}{input.board}
                    </span>
                  </li>
                ))}
              </ul>
            </li>
          ))}
        </ol>
        <p class="bomb">{L.bomb}</p>
      </article>
    ))
  }
</section>

<script>
  import { CHEM_EVENT, FINALS, loadChem, saveChem } from '../lib/chemistry';

  for (const root of document.querySelectorAll<HTMLElement>('[data-recipes]')) {
    const pick = root.querySelector<HTMLElement>('[data-pick]')!;
    const radios = [...root.querySelectorAll<HTMLInputElement>('input[name=chem-recipe]')];
    const recipes = [...root.querySelectorAll<HTMLElement>('[data-recipe]')];

    const show = (final: string) => {
      for (const radio of radios) radio.checked = radio.value === final;
      for (const recipe of recipes) recipe.hidden = recipe.dataset.recipe !== final;
    };

    // Saved with the calculator's numbers and announced, so the calculator lower down uses the same recipe.
    const choose = (final: string) => {
      show(final);
      saveChem({ ...loadChem(), final });
      window.dispatchEvent(new CustomEvent(CHEM_EVENT, { detail: final }));
    };

    for (const radio of radios) radio.addEventListener('change', () => choose(radio.value));
    window.addEventListener(CHEM_EVENT, (event) => show((event as CustomEvent<string>).detail));

    const saved = loadChem().final;
    pick.hidden = false;
    // First visit: the recipe shown by default also becomes the calculator's, so both agree from the start.
    if (saved && FINALS.includes(saved as never)) show(saved);
    else choose(FINALS[0]);
  }
</script>

<style>
  .recipes {
    margin: 1.25rem 0 1.75rem;
  }
  .pick {
    margin: 0 0 1rem;
    padding: 0;
    border: 0;
  }
  .pick legend {
    margin-bottom: 0.55rem;
    font-weight: 700;
  }
  .recipe {
    padding: clamp(1rem, 0.7rem + 1vw, 1.4rem);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    background: var(--surface);
  }
  .recipe + .recipe {
    margin-top: 1rem;
  }
  .recipe-title {
    margin: 0 0 0.75rem;
    font-size: var(--fs-lg);
    overflow-wrap: anywhere;
  }
  .reactions {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .reaction {
    padding: 0.8rem 0;
    border-top: 1px solid var(--border);
  }
  .reaction-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.6rem;
    margin: 0;
  }
  .reaction-num {
    padding: 0.1rem 0.5rem;
    border-radius: var(--r-sm);
    background: color-mix(in oklab, var(--accent) 16%, transparent);
    color: var(--accent-text);
    font-size: var(--fs-sm);
    font-weight: 700;
  }
  .put {
    margin: 0.55rem 0 0.3rem;
    color: var(--muted);
    font-size: var(--fs-sm);
  }
  .inputs {
    display: grid;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .inputs li {
    display: grid;
    gap: 0.1rem;
    padding: 0.5rem 0.75rem;
    border-left: 3px solid var(--border);
    background: var(--raised);
    border-radius: 0 var(--r-sm) var(--r-sm) 0;
  }
  .where {
    font-size: var(--fs-sm);
  }
  .board {
    color: var(--muted);
    font-size: var(--fs-xs);
  }
  .bomb {
    margin: 0.6rem 0 0;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border);
    font-weight: 700;
  }
</style>
