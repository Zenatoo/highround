---
import { render } from 'astro:content';
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import ChemistryCalculator from '../../../../../components/ChemistryCalculator.astro';
import ChemistryRecipes from '../../../../../components/ChemistryRecipes.astro';
import ChemistryShortcut from '../../../../../components/ChemistryShortcut.astro';
import Checklist from '../../../../../components/Checklist.astro';
import GuideHeader from '../../../../../components/GuideHeader.astro';
import GuideRail from '../../../../../components/GuideRail.astro';
import PlayMode from '../../../../../components/PlayMode.astro';
import Screenshot from '../../../../../components/Screenshot.astro';
import Shots from '../../../../../components/Shots.astro';
import Step from '../../../../../components/Step.astro';
import Tip from '../../../../../components/Tip.astro';
import Tips from '../../../../../components/Tips.astro';
import { categoryLabel, fill } from '../../../../../i18n/ui';
import { excerpt, guideAlternate, guidePaths } from '../../../../../lib/content';
import { href } from '../../../../../lib/url';

export const getStaticPaths = guidePaths;

const { guide, map, game, translation } = Astro.props;
const gameName = game.data.name;
const { lang } = guide;
const { Content } = await render(guide);
---

<BaseLayout
  lang={lang}
  title={`${guide.data.title} – ${map.data.name}`}
  description={excerpt(guide) ?? fill(lang, 'share.guide', { category: categoryLabel(lang, guide.data.category), map: map.data.name, game: gameName })}
  share={map.data.banner && { image: map.data.banner.image, alt: map.data.name, large: true }}
  {...guideAlternate(guide, translation)}
  crumbs={[
    { label: gameName, href: href(lang, guide.game) },
    { label: map.data.name, href: href(lang, guide.game, map.id) },
    { label: guide.data.title, href: href(lang, guide.game, map.id, guide.slug) },
  ]}
  sidebar={{ game, map, current: guide.slug }}
>
  <GuideHeader guide={guide} map={map} active="guide" />
  <div class="guide-layout">
    <article
      class="guide-body"
      data-guide-id={`${guide.game}/${guide.map}/${guide.slug}`}
      data-pagefind-meta={`map:${gameName} / ${map.data.name}`}
    >
      <span hidden data-pagefind-filter="game">{gameName}</span>
      <span hidden data-pagefind-filter="category">{categoryLabel(lang, guide.data.category)}</span>
      <Content components={{ Checklist, Step, Screenshot, Shots, Tips, Tip, ChemistryCalculator, ChemistryRecipes, ChemistryShortcut }} />
    </article>
    <GuideRail guide={guide} progress />
  </div>
  <PlayMode lang={lang} mapName={map.data.name} guideTitle={guide.data.title} />
</BaseLayout>

<style>
  .guide-body {
    min-width: 0;
    /* One step count for the whole guide, even when it is split into several checklists. */
    counter-reset: step;
  }
  .guide-body > :global(h2) {
    margin: 2.25rem 0 1rem;
  }
  .guide-body > :global(p) {
    max-width: var(--measure);
  }
</style>
